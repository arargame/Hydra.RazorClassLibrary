@typeparam T where T : class, new()
@using Hydra.DTOs
@using Hydra.DataModels
@using Hydra.RazorClassLibrary.Services.Core
@using Hydra.RazorClassLibrary.Utils
@using Microsoft.JSInterop
@inject LookupService Lookup
@inject IJSRuntime JSRuntime
@implements IDetailsTabsHost

@* Meta-veri güdümlü detay (DetailsView) ekranı.
   Yapı: başlık kartı (aksiyonlar) → özet kartı (ana property'ler) → sekmeli koleksiyon kartı.
   GedenLines mimarisi referans alınarak:
   - Özellik etiketleri ve değerleri ayrıştırılmış renk ve tipografi ile sunulur.
   - Tarih/Saat alanları dostane tarih-saat formatında gösterilir, tıklandığında tam ISO kopyalanır.
   - Boolean alanlar salt-okunur onay kutusu (disabled checkbox) veya durum rozeti ile sunulur.
   - Uzun metinler (Description vb.) kırpılarak 'Read more / Show less' ile yönetilir.
   - Kimlik ve Yabancı Anahtar (FK) alanları doğrudan ilgili nesneye giden tıklanabilir linktir.
   - Sekme geçişleri reaktif olay mekanizması ile izole edilir; çoklu koleksiyon sızıntısı engellenir. *@

@if (IsLoading)
{
    <SpinnerComponent />
}
else if (Table == null || Row == null)
{
    <div class="hydra-details__empty">Record not found.</div>
}
else
{
    <div class="hydra-details">

        <header class="hydra-details__header">
            <div class="hydra-details__heading">
                <div class="hydra-details__eyebrow-row">
                    <span class="hydra-details__eyebrow">@Title</span>
                    <span class="hydra-details__dot"></span>
                    @if (ActiveState != null)
                    {
                        <span class="hydra-details__state">@(ActiveState.Value ? "Active" : "Inactive")</span>
                    }
                </div>
                <h1 class="hydra-details__title">@RecordTitle</h1>
            </div>

            <div class="hydra-details__actions">
                <button type="button" class="hydra-btn hydra-btn--secondary" @onclick="GoBack">
                    <i class="hydra-icon bi bi-arrow-left"></i>
                    <span>Back</span>
                </button>
                <button type="button" class="hydra-btn hydra-btn--edit" @onclick="GoToEdit">
                    <i class="hydra-icon bi bi-pencil"></i>
                    <span>Edit</span>
                </button>
                <button type="button" class="hydra-btn hydra-btn--delete" @onclick="() => ShowDeleteConfirm = true">
                    <i class="hydra-icon bi bi-trash"></i>
                    <span>Delete</span>
                </button>
            </div>
        </header>

        <div class="hydra-details__body">
            @if (DisplayColumns.Any())
            {
                <div class="hydra-details__summary-body">
                    @foreach (var column in DisplayColumns)
                    {
                        var rawValue = GetRawValue(column);
                        var isDateTime = DateTimeHelper.IsDateTimeColumn(column);
                        var isBool = column.ValueType == ColumnValueType.Boolean || column.Name == "IsActive" || column.Name == "IsAssignable";
                        var isIdColumn = column.Name == "Id" || column.IsPrimaryKey;
                        var navLink = GetNavigationLink(column);

                        <div class="hydra-details__pair">
                            <span class="hydra-details__pair-label">@column.DisplayName</span>
                            <span class="hydra-details__pair-value">
                                @if (isDateTime)
                                {
                                    var friendlyDate = DateTimeHelper.FormatFriendly(rawValue);
                                    var fullIso = DateTimeHelper.FormatIsoPrecise(rawValue);
                                    <span class="hydra-details__datetime" title="Full Timestamp: @fullIso (Click to copy)"
                                          @onclick="() => CopyToClipboard(fullIso)">
                                        <i class="hydra-icon bi bi-calendar3"></i>
                                        <span>@friendlyDate</span>
                                        <i class="hydra-icon bi bi-copy hydra-details__copy-icon"></i>
                                    </span>
                                }
                                else if (isBool)
                                {
                                    var bVal = GetBoolValue(column);
                                    if (bVal == true)
                                    {
                                        <span class="hydra-details__bool hydra-details__bool--true" title="Yes / Enabled (Read-only)">
                                            <i class="hydra-icon bi bi-check-square-fill"></i>
                                            <span>Yes</span>
                                        </span>
                                    }
                                    else if (bVal == false)
                                    {
                                        <span class="hydra-details__bool hydra-details__bool--false" title="No / Disabled (Read-only)">
                                            <i class="hydra-icon bi bi-square"></i>
                                            <span>No</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hydra-text-muted">—</span>
                                    }
                                }
                                else if (isIdColumn && rawValue != null)
                                {
                                    var idStr = rawValue.ToString() ?? string.Empty;
                                    <span class="hydra-details__id-pill font-mono" title="Click to copy Id: @idStr"
                                          @onclick="() => CopyToClipboard(idStr)">
                                        <i class="hydra-icon bi bi-fingerprint"></i>
                                        <span class="hydra-details__id-text">@idStr</span>
                                        <i class="hydra-icon bi bi-copy hydra-details__copy-icon"></i>
                                    </span>
                                }
                                else if (navLink != null)
                                {
                                    <a class="hydra-details__link" href="@navLink">
                                        <i class="hydra-icon bi bi-box-arrow-up-right me-1"></i>
                                        <span>@GetValue(column)</span>
                                    </a>
                                }
                                else
                                {
                                    var textVal = GetValue(column) ?? string.Empty;
                                    if (textVal.Length > 100 || column.Name == "Description")
                                    {
                                        var isExpanded = _expandedColumns.Contains(column.Name!);
                                        <div class="hydra-details__text-container">
                                            <span class="hydra-details__text">
                                                @(isExpanded || textVal.Length <= 100 ? textVal : textVal.Substring(0, 100) + "...")
                                            </span>
                                            @if (textVal.Length > 100)
                                            {
                                                <button type="button" class="hydra-details__read-more-btn"
                                                        @onclick="() => ToggleExpand(column.Name!)">
                                                    @(isExpanded ? "Show less" : "Read more")
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span>@(string.IsNullOrWhiteSpace(textVal) ? "—" : textVal)</span>
                                    }
                                }
                            </span>
                        </div>
                    }
                </div>
            }

            <CascadingValue Value="(IDetailsTabsHost)this" IsFixed="false">

                @* Sekme şeridi. Sekmeler, alttaki panellerin OnInitialized'ında kaydolur;
                   bu yüzden ilk render'da boş olabilir, kayıt sonrası StateHasChanged ile dolar. *@
                @if (_tabs.Count > 0)
                {
                    <div class="hydra-details__tabstrip" role="tablist">
                        @foreach (var tab in _tabs)
                        {
                            var isActive = Equals(_activeTabKey, tab.Key);

                            <button type="button" role="tab"
                                    class="hydra-details__tab @(isActive ? "hydra-details__tab--active" : "")"
                                    @onclick="() => SetActiveTab(tab.Key)">
                                <span>@tab.Title</span>
                                @if (tab.Count >= 0)
                                {
                                    <span class="hydra-details__tab-count">(@tab.Count)</span>
                                }
                                @if (isActive)
                                {
                                    <span class="hydra-details__dot"></span>
                                }
                            </button>
                        }
                    </div>
                }

                <div class="hydra-details__tabpanels">
                    @ChildContent

                    @if (ShowLogsTab)
                    {
                        @* Log'a FK yok: filtre EntityId (string) + EntityType üzerinden kurulur. *@
                        <CollectionViewSection Title="Logs"
                                               Controller="Log"
                                               ForeignKeyName="EntityId"
                                               ParentId="@Id"
                                               ForeignKeyValue="@Id.ToString()"
                                               ExtraFilters="@LogFilters"
                                               ShowCreateButton="false"
                                               ShowDetailsColumn="false"
                                               PageSize="10" />
                    }
                </div>
            </CascadingValue>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_copiedToast))
    {
        <div class="hydra-details__toast" role="status">
            <i class="hydra-icon bi bi-clipboard-check"></i>
            <span>@_copiedToast</span>
        </div>
    }

    <ConfirmDialogComponent @bind-IsOpen="ShowDeleteConfirm"
                            Title="Delete Record"
                            Message="Are you sure you want to delete this record? This action cannot be undone."
                            ConfirmText="Delete"
                            Variant="danger"
                            OnConfirm="DeleteAsync" />
}

@code {
    [Inject] public NavigationManager Navigation { get; set; } = default!;

    [Parameter, EditorRequired] public ApiClient<T> Client { get; set; } = default!;
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? BasePath { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Her nesnenin detayında, en sonda otomatik "Loglar" sekmesi gösterilsin mi.</summary>
    [Parameter] public bool ShowLogsTab { get; set; } = true;

    /// <summary>Log satırlarını bu kaydın tipine göre daraltır (EntityId tek başına da benzersizdir,
    /// EntityType filtresi indeksten faydalanmak ve doğruluğu garantilemek için eklenir).</summary>
    private Dictionary<string, object?> LogFilters => new() { ["EntityType"] = typeof(T).Name };

    private TableDTO? Table;
    private RowDTO? Row;
    private bool IsLoading = true;
    private bool ShowDeleteConfirm;

    private readonly List<TabEntry> _tabs = new();
    private object? _activeTabKey;
    private readonly HashSet<string> _expandedColumns = new();
    private string? _copiedToast;

    private record TabEntry(object Key, string Title, int Count);

    /// <summary>Başlıkta kaydın kendi adı gösterilir; yoksa ekran başlığına düşer.</summary>
    private string? RecordTitle
    {
        get
        {
            var name = Row?.GetValueByColumnName("Name")?.ToString();
            return string.IsNullOrWhiteSpace(name) ? Title : name;
        }
    }

    /// <summary>BaseObject'ten gelen IsActive alanı varsa durum rozeti gösterilir, yoksa hiç gösterilmez.</summary>
    private bool? ActiveState
    {
        get
        {
            var raw = Row?.GetValueByColumnName("IsActive")?.ToString();
            if (string.IsNullOrWhiteSpace(raw))
                return null;

            if (bool.TryParse(raw, out var parsed))
                return parsed;

            return raw == "1" ? true : raw == "0" ? false : null;
        }
    }

    // ---- IDetailsTabsHost ----

    public event Action? OnActiveTabChanged;

    object? IDetailsTabsHost.ActiveTabKey => _activeTabKey;

    void IDetailsTabsHost.RegisterTab(object key, string title)
    {
        if (_tabs.Any(t => Equals(t.Key, key)))
            return;

        _tabs.Add(new TabEntry(key, title, -1));
        _activeTabKey ??= key;

        InvokeAsync(StateHasChanged);
    }

    void IDetailsTabsHost.UpdateTabCount(object key, int count)
    {
        var index = _tabs.FindIndex(t => Equals(t.Key, key));
        if (index < 0)
            return;

        _tabs[index] = _tabs[index] with { Count = count };
        InvokeAsync(StateHasChanged);
    }

    private void SetActiveTab(object key)
    {
        if (!Equals(_activeTabKey, key))
        {
            _activeTabKey = key;
            OnActiveTabChanged?.Invoke();
            StateHasChanged();
        }
    }

    // ---- Veri & Helper'lar ----

    private List<MetaColumnDTO> DisplayColumns => Table == null
        ? new List<MetaColumnDTO>()
        : Table.GetSelectedMetaColumnsWithIncludes
               .Where(c => !c.IsJoinedTableKey) //gizli join Id kolonlarını gösterme
               .OrderBy(c => c.Priority)
               .ToList();

    protected override async Task OnInitializedAsync()
    {
        BasePath ??= Client.Controller;
        Title ??= $"{Client.Controller} Details";

        try
        {
            Table = await Client.GetDetailsViewAsync(Id);
            Row = Table?.Rows?.FirstOrDefault();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private object? GetRawValue(MetaColumnDTO column)
        => Row?.GetValueByColumnName(column.BelongsToJoins ? column.Alias : column.Name);

    /// <summary>Ham değeri kolonun metadata'sına göre okunabilir metne çevirir
    /// (enum 0/1/2 → isim, boolean → Evet/Hayır). Bkz. LookupService.GetDisplayText.</summary>
    private string? GetValue(MetaColumnDTO column)
        => Lookup.GetDisplayText(column, GetRawValue(column));

    private bool? GetBoolValue(MetaColumnDTO column)
    {
        var raw = GetRawValue(column)?.ToString();
        if (string.IsNullOrWhiteSpace(raw)) return null;
        if (bool.TryParse(raw, out var b)) return b;
        return raw == "1" ? true : raw == "0" ? false : null;
    }

    private string? GetNavigationLink(MetaColumnDTO column)
    {
        var navigation = column.NavigationColumnInfoDTO;
        if (navigation != null)
        {
            // Flatten kolon öneki alias'tan gelir (ör. CreatedByEmployee_Id), rota ise gerçek tablodan (Employee).
            var rightId = Row?.GetValueByColumnName($"{navigation.EffectiveRightTableAlias}_Id");
            if (rightId != null)
                return $"/{navigation.RightTableName}/Details/{rightId}";
        }

        // Otomatik FK algılama (ör. RequestCategoryId -> /RequestCategory/Details/{Guid})
        if (column.Name != null && column.Name.EndsWith("Id", StringComparison.OrdinalIgnoreCase) && !column.Name.Equals("Id", StringComparison.OrdinalIgnoreCase))
        {
            var targetController = column.Name[..^2];
            var val = GetRawValue(column)?.ToString();
            if (Guid.TryParse(val, out var g) && g != Guid.Empty)
            {
                return $"/{targetController}/Details/{g}";
            }
        }

        return null;
    }

    private void ToggleExpand(string columnName)
    {
        if (!_expandedColumns.Add(columnName))
            _expandedColumns.Remove(columnName);
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copiedToast = "Copied to clipboard!";
            StateHasChanged();
            await Task.Delay(2000);
            _copiedToast = null;
            StateHasChanged();
        }
        catch
        {
            _copiedToast = text;
            StateHasChanged();
            await Task.Delay(2000);
            _copiedToast = null;
            StateHasChanged();
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/{BasePath}");

    private void GoToEdit() => Navigation.NavigateTo($"/{BasePath}/Update/{Id}");

    private async Task DeleteAsync()
    {
        var success = await Client.DeleteAsync(Id);

        if (success)
            Navigation.NavigateTo($"/{BasePath}");
    }
}
