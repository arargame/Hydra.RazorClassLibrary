@typeparam T where T : class, new()
@using Hydra.DTOs
@using Hydra.DataModels
@using Hydra.RazorClassLibrary.Services.Core
@using Hydra.RazorClassLibrary.Services.Status
@using System.Globalization
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@implements IDisposable

@* Create + Edit modlarını tek yerden yöneten meta-veri güdümlü form motoru.
   Id verilirse Edit, verilmezse Create modunda çalışır.

   TEMA NOTU: CSS framework'süz, sadece anlamsal "hydra-*" class'ları basar (bkz. HydraGrid).
   Mod farkı da class ile taşınır: kök elemana hydra-form--create / hydra-form--edit eklenir ve
   kaydet butonu hydra-btn--create (Create) veya hydra-btn--edit-save (Edit) alır. Böylece
   "Create yeşil, Edit mavi" gibi renk kararlarını tema dosyası verir, bileşen değil. *@

@if (IsLoading)
{
    <SpinnerComponent />
}
else if (Table == null)
{
    <div class="hydra-form__alert">Form metadata could not be loaded.</div>
}
else if (IsSavedSuccess)
{
    <div class="hydra-form hydra-form--celebration">
        <div class="hydra-form__celebration" role="status">
            <div class="hydra-form__celebration-icon-wrapper">
                <i class="hydra-icon bi bi-check2-circle hydra-form__celebration-icon"></i>
            </div>
            <h2 class="hydra-form__celebration-title">
                @(IsEditMode ? "Changes Saved Successfully!" : "Record Created Successfully!")
            </h2>
            <p class="hydra-form__celebration-text">
                @(IsEditMode
                    ? $"The changes to {Client.Controller} have been saved successfully."
                    : $"New {Client.Controller} record has been created successfully.")
            </p>

            <div class="hydra-form__celebration-actions">
                @if (SavedEntityId.HasValue && SavedEntityId.Value != Guid.Empty)
                {
                    <button type="button" class="hydra-btn hydra-btn--primary" @onclick="GoToDetails">
                        <i class="hydra-icon bi bi-eye"></i>
                        <span>View Details</span>
                    </button>
                }

                <button type="button" class="hydra-btn hydra-btn--create" @onclick="GoToList">
                    <i class="hydra-icon bi bi-list-ul"></i>
                    <span>Back to List</span>
                </button>

                @if (!IsEditMode)
                {
                    <button type="button" class="hydra-btn hydra-btn--ghost" @onclick="CreateAnother">
                        <i class="hydra-icon bi bi-plus-lg"></i>
                        <span>Create Another</span>
                    </button>
                }
                else
                {
                    <button type="button" class="hydra-btn hydra-btn--ghost" @onclick="ContinueEditing">
                        <i class="hydra-icon bi bi-pencil"></i>
                        <span>Continue Editing</span>
                    </button>
                }
            </div>

            @if (CountdownSeconds.HasValue && CountdownSeconds.Value > 0)
            {
                <div class="hydra-form__celebration-countdown" @onclick="CancelCountdown" title="Click to stay on this screen">
                    <i class="hydra-icon bi bi-clock"></i>
                    <span>Redirecting to list in @(CountdownSeconds)s... (click to cancel)</span>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="hydra-form @(IsEditMode ? "hydra-form--edit" : "hydra-form--create")">

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="hydra-form__banner" role="alert" style="display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <i class="hydra-icon bi bi-exclamation-octagon hydra-form__banner-icon"></i>
                    <div>
                        <h3 class="hydra-form__banner-title">Something went wrong</h3>
                        <p class="hydra-form__banner-text">@ErrorMessage</p>
                    </div>
                </div>
                <button type="button" class="hydra-btn hydra-btn--ghost" style="padding: 4px 8px; font-size: 14px;" @onclick="() => ErrorMessage = null">
                    <i class="hydra-icon bi bi-x-lg"></i>
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="hydra-form__banner hydra-form__banner--success" role="alert" style="display: flex; align-items: center; justify-content: space-between; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #10b981; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <i class="hydra-icon bi bi-check-circle" style="font-size: 1.5rem;"></i>
                    <div>
                        <h3 class="hydra-form__banner-title" style="color: #10b981; margin: 0; font-size: 1rem; font-weight: 600;">Success</h3>
                        <p class="hydra-form__banner-text" style="color: #6ee7b7; margin: 0; font-size: 0.875rem;">@SuccessMessage</p>
                    </div>
                </div>
                <button type="button" class="hydra-btn hydra-btn--ghost" style="padding: 4px 8px; font-size: 14px; color: #10b981;" @onclick="() => SuccessMessage = null">
                    <i class="hydra-icon bi bi-x-lg"></i>
                </button>
            </div>
        }

        <div class="hydra-form__header">
            <div>
                <h1 class="hydra-form__title">@Title</h1>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="hydra-form__subtitle">@Subtitle</p>
                }
            </div>
            <button type="button" class="hydra-btn hydra-btn--ghost hydra-form__back" @onclick="GoBack">
                <i class="hydra-icon bi bi-arrow-left"></i>
                <span>Back</span>
            </button>
        </div>

        <div class="hydra-form__body">
            <div class="hydra-form__grid">
                @foreach (var field in Fields)
                {
                    var prefilled = _prefilledFields.Contains(field.Name!);
                    var isWide = IsWideField(field);
                    var isBool = IsBooleanField(field);
                    var hasError = TryGetFieldError(field, out var fieldError);

                    <div class="hydra-form__field @(isWide ? "hydra-form__field--wide" : "") @(isBool ? "hydra-form__field--boolean" : "") @(hasError ? "hydra-form__field--invalid" : "")">
                        <div class="hydra-form__label-row">
                            <label class="hydra-form__label" for="@($"field-{field.Name}")">
                                @if (prefilled)
                                {
                                    <i class="hydra-icon bi bi-lock-fill"></i>
                                }
                                @field.DisplayName
                                @if (IsRequired(field))
                                {
                                    <span class="hydra-form__required">*</span>
                                }
                            </label>
                            @if (prefilled)
                            {
                                <span class="hydra-form__badge">Prefilled</span>
                            }
                        </div>

                        <ColumnFieldComponent Column="@field"
                                              Value="@GetModelValue(field)"
                                              ValueChanged="@(v => SetModelValue(field, v))"
                                              Options="@GetOptions(field)"
                                              Disabled="@IsFieldDisabled(field)" />

                        @if (hasError && !string.IsNullOrEmpty(fieldError))
                        {
                            <span class="hydra-form__field-error">
                                <i class="hydra-icon bi bi-exclamation-circle"></i>
                                <span>@fieldError</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="hydra-form__footer">
            <button type="button" class="hydra-btn hydra-btn--ghost" @onclick="GoBack">Cancel</button>
            <button type="button"
                    class="hydra-btn @(IsEditMode ? "hydra-btn--edit-save" : "hydra-btn--create")"
                    disabled="@IsSaving"
                    @onclick="Save">
                @if (IsSaving)
                {
                    <i class="hydra-icon hydra-btn__spinner"></i>
                }
                else
                {
                    <i class="hydra-icon bi @(IsEditMode ? "bi-check-circle-fill" : "bi-plus-lg")"></i>
                }
                <span>@(IsEditMode ? "Save" : "Create")</span>
            </button>
        </div>
    </div>
}

@code {
    [Inject] public NavigationManager Navigation { get; set; } = default!;
    [Inject] public LookupService Lookup { get; set; } = default!;
    [Inject] public HydraStatusNotifier? StatusNotifier { get; set; }

    [Parameter, EditorRequired] public ApiClient<T> Client { get; set; } = default!;

    /// <summary>Null ise Create, dolu ise Edit modu.</summary>
    [Parameter] public Guid? Id { get; set; }

    [Parameter] public string? Title { get; set; }

    /// <summary>Başlığın altında görünen isteğe bağlı açıklama satırı.</summary>
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? BasePath { get; set; }
    [Parameter] public EventCallback<T> OnSaved { get; set; }
    [Parameter] public bool StayOnPageAfterSave { get; set; } = false;
    [Parameter] public int AutoRedirectDelaySeconds { get; set; } = 5;

    private bool IsEditMode => Id.HasValue;

    private TableDTO? Table;
    private T Model = new();
    private List<MetaColumnDTO> Fields = new();
    private readonly Dictionary<string, List<DropdownListOption>> _optionsByField = new();
    private readonly Dictionary<string, object?> _rawValues = new();
    private readonly HashSet<string> _prefilledFields = new();
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    private bool IsLoading = true;
    private bool IsSaving;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsSavedSuccess;
    private Guid? SavedEntityId;
    private int? CountdownSeconds;
    private CancellationTokenSource? _countdownCts;

    protected override async Task OnInitializedAsync()
    {
        BasePath ??= Client.Controller;
        Title ??= IsEditMode ? $"Edit {Client.Controller}" : $"New {Client.Controller}";

        try
        {
            if (IsEditMode)
            {
                Table = await Client.GetUpdateViewAsync(Id!.Value);
                Model = await Client.GetByIdAsync(Id.Value) ?? new T();
            }
            else
            {
                Table = await Client.GetCreateViewAsync();
                Model = new T();
            }

            BuildFields();

            if (!IsEditMode)
            {
                ApplyDefaultValues();
                ApplyQueryStringPrefills();
            }

            await ResolveOptionsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load the form: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void BuildFields()
    {
        if (Table == null) return;

        Fields = Table.MetaColumns
            .Where(mc => mc.IsFilteredColumn && mc.CreateViewComponentFromThis)
            .Where(mc => !string.Equals(mc.Name, "Id", StringComparison.OrdinalIgnoreCase))
            .Where(mc => GetProperty(mc.Name) != null) //entity üzerinde karşılığı olmayan alanları (ör. IsHidden) atla
            .GroupBy(mc => mc.Name)
            .Select(g => g.First())
            .OrderBy(mc => mc.FilterDTO?.Priority ?? 0)
            .ToList();
    }

    private void ApplyDefaultValues()
    {
        foreach (var field in Fields.Where(f => f.DefaultValue != null))
        {
            SetModelValueCore(field, field.DefaultValue);
        }
    }

    private void ApplyQueryStringPrefills()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        foreach (var field in Fields)
        {
            var value = query[field.Name!];

            if (!string.IsNullOrEmpty(value))
            {
                SetModelValueCore(field, value);
                _prefilledFields.Add(field.Name!);
            }
        }
    }

    private async Task ResolveOptionsAsync()
    {
        foreach (var field in Fields)
        {
            List<DropdownListOption>? options = null;

            if (field.IsForeignKey && field.NavigationColumnInfoDTO != null)
            {
                options = await Lookup.GetNavigationOptionsAsync(field.NavigationColumnInfoDTO, addEmptyOption: true);
            }
            else if (field.ValueType == ColumnValueType.Enum)
            {
                options = Lookup.GetEnumOptions(field.PropertyTypeName);
            }
            else if (field.ValueType == ColumnValueType.Boolean &&
                     (field.HtmlElementType == HtmlElementType.DropdownList || field.HtmlElementType == HtmlElementType.DataList))
            {
                options = Lookup.GetBooleanOptions();
            }

            if (options != null)
                _optionsByField[field.Name!] = options;
        }
    }

    private List<DropdownListOption>? GetOptions(MetaColumnDTO field)
        => _optionsByField.TryGetValue(field.Name!, out var options) ? options : null;

    private bool IsFieldDisabled(MetaColumnDTO field)
        => field.IsDisabled || _prefilledFields.Contains(field.Name!);

    private static bool IsWideField(MetaColumnDTO field)
        => field.HtmlElementType is HtmlElementType.TextArea or HtmlElementType.RichTextEditor;

    private static bool IsBooleanField(MetaColumnDTO field)
        => field.HtmlInputType == HtmlInputType.checkbox || field.ValueType == ColumnValueType.Boolean;

    /// <summary>Zorunluluk metadata'da veya entity üzerindeki CLR tipinden ve attribute'lardan çıkarılır.
    /// [Required] attribute'u olanlar veya nullable olmayan değer tipleri (Guid, int, DateTime, enum)
    /// mutlaka bir değer almak zorundadır. bool hariç tutulur.</summary>
    private bool IsRequired(MetaColumnDTO field)
    {
        var property = GetProperty(field.Name);

        if (property == null)
            return false;

        if (property.GetCustomAttribute<RequiredAttribute>() != null)
            return true;

        var type = property.PropertyType;

        return type.IsValueType
               && Nullable.GetUnderlyingType(type) == null
               && type != typeof(bool);
    }

    private bool TryGetFieldError(MetaColumnDTO field, out string? error)
    {
        if (_fieldErrors.TryGetValue(field.Name!, out error))
            return true;

        if (field.Name != null && field.Name.EndsWith("Id", StringComparison.OrdinalIgnoreCase))
        {
            var baseName = field.Name[..^2];
            if (_fieldErrors.TryGetValue(baseName, out error))
                return true;
        }

        error = null;
        return false;
    }

    private PropertyInfo? GetProperty(string? name)
        => string.IsNullOrEmpty(name) ? null : typeof(T).GetProperty(name);

    private object? GetModelValue(MetaColumnDTO field)
    {
        var prop = GetProperty(field.Name);

        var value = prop?.GetValue(Model);

        if (value == null)
            return null;

        //Enum değerleri dropdown key'i (int) ile eşleşmeli
        if (prop!.PropertyType.IsEnum || (Nullable.GetUnderlyingType(prop.PropertyType)?.IsEnum ?? false))
            return Convert.ToInt32(value);

        return value;
    }

    private void SetModelValue(MetaColumnDTO field, object? raw)
    {
        SetModelValueCore(field, raw);

        // Kullanıcı alana değer girdiğinde o alana ait hata uyarısını anında temizle
        if (field.Name != null)
        {
            _fieldErrors.Remove(field.Name);
            if (field.Name.EndsWith("Id", StringComparison.OrdinalIgnoreCase))
                _fieldErrors.Remove(field.Name[..^2]);

            if (_fieldErrors.Count == 0 && ErrorMessage == "Please check the required fields.")
                ErrorMessage = null;
        }

        StateHasChanged();
    }

    private void SetModelValueCore(MetaColumnDTO field, object? raw)
    {
        var prop = GetProperty(field.Name);

        if (prop == null || !prop.CanWrite)
            return;

        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
        var isNullable = !prop.PropertyType.IsValueType || Nullable.GetUnderlyingType(prop.PropertyType) != null;

        var s = raw?.ToString();

        object? converted = null;

        try
        {
            if (raw is bool b && targetType == typeof(bool))
            {
                converted = b;
            }
            else if (string.IsNullOrEmpty(s))
            {
                converted = null;
            }
            else if (targetType == typeof(string))
            {
                converted = s;
            }
            else if (targetType == typeof(Guid))
            {
                converted = Guid.TryParse(s, out var g) ? g : null;
            }
            else if (targetType.IsEnum)
            {
                converted = int.TryParse(s, out var ei)
                                ? Enum.ToObject(targetType, ei)
                                : Enum.Parse(targetType, s, ignoreCase: true);
            }
            else if (targetType == typeof(bool))
            {
                converted = s.Equals("true", StringComparison.OrdinalIgnoreCase) || s == "1" || s == "on";
            }
            else if (targetType == typeof(DateTime))
            {
                converted = DateTime.Parse(s, CultureInfo.InvariantCulture);
            }
            else
            {
                converted = Convert.ChangeType(s, targetType, CultureInfo.InvariantCulture);
            }
        }
        catch
        {
            converted = null;
        }

        if (converted == null && !isNullable)
            converted = Activator.CreateInstance(prop.PropertyType);

        prop.SetValue(Model, converted);

        if (_fieldErrors.Remove(field.Name!))
        {
            if (_fieldErrors.Count == 0 && ErrorMessage == "Please check the required fields.")
                ErrorMessage = null;
        }
    }

    private bool ValidateForm()
    {
        _fieldErrors.Clear();

        // 1. Model IValidatableObject ise C# kurallarını istemci tarafında da çalıştır (DRY)
        if (Model is IValidatableObject validatable)
        {
            var context = new ValidationContext(Model);
            var results = validatable.Validate(context);
            if (results != null)
            {
                foreach (var result in results)
                {
                    foreach (var memberName in result.MemberNames)
                    {
                        if (!_fieldErrors.ContainsKey(memberName))
                            _fieldErrors[memberName] = result.ErrorMessage ?? "Invalid value.";
                    }
                }
            }
        }

        // 2. IsRequired işaretli alanlar için boşluk kontrolü (henüz yakalanmamışsa)
        foreach (var field in Fields)
        {
            if (IsRequired(field) && !TryGetFieldError(field, out _))
            {
                var val = GetModelValue(field);
                bool isEmpty = val == null ||
                               (val is string s && string.IsNullOrWhiteSpace(s)) ||
                               (val is Guid g && g == Guid.Empty);

                if (isEmpty)
                {
                    _fieldErrors[field.Name!] = $"{field.DisplayName} is required.";
                }
            }
        }

        if (_fieldErrors.Count > 0)
        {
            ErrorMessage = "Please check the required fields.";
            return false;
        }

        return true;
    }

    private async Task Save()
    {
        ErrorMessage = null;

        if (!ValidateForm())
        {
            StateHasChanged();
            return;
        }

        IsSaving = true;

        try
        {
            var saveStartedAt = DateTime.Now;

            var result = IsEditMode
                            ? await Client.UpdateAsync(Model)
                            : await Client.CreateAsync(Model);

            if (result != null)
            {
                await OnSaved.InvokeAsync(result);

                SavedEntityId = GetSavedId(result);
                IsSavedSuccess = true;
                ErrorMessage = null;

                if (AutoRedirectDelaySeconds > 0 && !StayOnPageAfterSave)
                {
                    StartCountdown(AutoRedirectDelaySeconds);
                }
            }
            else
            {
                if (StatusNotifier?.Last != null &&
                    StatusNotifier.Last.OccurredAt >= saveStartedAt.AddSeconds(-2) &&
                    StatusNotifier.Last.Messages.Any())
                {
                    ErrorMessage = string.Join(" ", StatusNotifier.Last.Messages);
                }
                else if (StatusNotifier?.Last?.Definition?.UserMessage != null &&
                         StatusNotifier.Last.OccurredAt >= saveStartedAt.AddSeconds(-2))
                {
                    ErrorMessage = StatusNotifier.Last.Definition.UserMessage;
                }
                else
                {
                    ErrorMessage = "Save failed. Please check the required fields.";
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/{BasePath}");

    private Guid? GetSavedId(T? item)
    {
        if (item == null) return Id;

        var prop = item.GetType().GetProperty("Id", BindingFlags.Public | BindingFlags.Instance);
        if (prop != null)
        {
            var val = prop.GetValue(item);
            if (val is Guid g && g != Guid.Empty)
                return g;
        }

        return Id;
    }

    private void GoToDetails()
    {
        DisposeCountdown();
        if (SavedEntityId.HasValue && SavedEntityId.Value != Guid.Empty)
        {
            Navigation.NavigateTo($"/{BasePath}/Details/{SavedEntityId.Value}");
        }
        else
        {
            Navigation.NavigateTo($"/{BasePath}");
        }
    }

    private void GoToList()
    {
        DisposeCountdown();
        Navigation.NavigateTo($"/{BasePath}");
    }

    private async Task CreateAnother()
    {
        DisposeCountdown();
        IsSavedSuccess = false;
        SavedEntityId = null;
        ErrorMessage = null;
        SuccessMessage = null;
        _fieldErrors.Clear();
        Model = new T();
        ApplyDefaultValues();
        ApplyQueryStringPrefills();
        await ResolveOptionsAsync();
        StateHasChanged();
    }

    private void ContinueEditing()
    {
        DisposeCountdown();
        IsSavedSuccess = false;
        StateHasChanged();
    }

    private void CancelCountdown()
    {
        DisposeCountdown();
        CountdownSeconds = null;
        StateHasChanged();
    }

    private async void StartCountdown(int seconds)
    {
        DisposeCountdown();
        _countdownCts = new CancellationTokenSource();
        var token = _countdownCts.Token;
        CountdownSeconds = seconds;
        StateHasChanged();

        try
        {
            while (CountdownSeconds > 0 && !token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                CountdownSeconds--;
                await InvokeAsync(StateHasChanged);
            }

            if (!token.IsCancellationRequested && IsSavedSuccess)
            {
                await InvokeAsync(GoToList);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void DisposeCountdown()
    {
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
        _countdownCts = null;
    }

    public void Dispose()
    {
        DisposeCountdown();
    }
}
