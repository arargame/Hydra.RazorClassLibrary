@typeparam T where T : class
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Hydra.AccessManagement.Authorization
@using Hydra.RazorClassLibrary.Services.Core
@using Hydra.DTOs
@using Hydra.RazorClassLibrary.Components.Grids

@* Meta-veri güdümlü liste ekranı: filtre barı + grid + sayfalama + CRUD aksiyonları.

   TEMA NOTU: CSS framework'süz. Sadece anlamsal "hydra-*" class'ları basar; görünüm host
   projenin stylesheet'inden gelir (bkz. HydraGrid'deki açıklama). Renk konvansiyonu class
   isimleriyle taşınır — hydra-btn--create / --edit / --delete / --details — böylece her proje
   kendi paletini uygulayabilir. *@

@if (IsLoading)
{
    <SpinnerComponent />
}
else if (Table == null)
{
    <div class="hydra-grid__empty">
        <i class="hydra-icon bi bi-exclamation-triangle"></i>
        <span>Unable to load data. Please check your connection and try again.</span>
    </div>
}
else
{
    <div class="hydra-listview">
        <div class="hydra-listview__header">
            <h2 class="hydra-listview__title">@Title</h2>
            <div class="hydra-listview__actions">
                @if (ShowFilterToggle)
                {
                    <button type="button" class="hydra-btn hydra-btn--secondary @(ShowFilters ? "hydra-btn--active" : "")"
                            @onclick="() => ShowFilters = !ShowFilters">
                        <i class="hydra-icon bi bi-funnel"></i>
                        <span>Filters</span>
                    </button>
                }
                @if (ShowCreateButton && CanCreate)
                {
                    <button type="button" class="hydra-btn hydra-btn--create" @onclick="GoToCreate">
                        <i class="hydra-icon bi bi-plus-lg"></i>
                        <span>New Record</span>
                    </button>
                }
            </div>
        </div>

        @if (ShowFilters)
        {
            <FilterBarComponent Table="@Table" TableChanged="OnTableChanged" />
        }

        <div class="hydra-listview__body">
            <HydraGrid Table="@Table" TableChanged="OnTableChanged" HasActions="true"
                       ShowDetailsColumnIfBound="@ShowDetailsColumn" DetailsClicked="@(id => GoToDetails(id))">
                <ChildContent Context="row">
                    @if (RowActions != null)
                    {
                        @RowActions(row)
                    }
                    else
                    {
                        @if (CanUpdate)
                        {
                            <button type="button" class="hydra-btn hydra-btn--icon hydra-btn--edit" title="Edit"
                                    @onclick="() => GoToUpdate(row.Id)">
                                <i class="hydra-icon bi bi-pencil"></i>
                            </button>
                        }
                        @if (CanDelete)
                        {
                            <button type="button" class="hydra-btn hydra-btn--icon hydra-btn--delete" title="Delete"
                                    @onclick="() => AskDelete(row.Id)">
                                <i class="hydra-icon bi bi-trash"></i>
                            </button>
                        }
                    }
                </ChildContent>
            </HydraGrid>
        </div>
    </div>

    <ConfirmDialogComponent @bind-IsOpen="ShowDeleteConfirm"
                            Title="Delete Record"
                            Message="Are you sure you want to delete this record? This action cannot be undone."
                            ConfirmText="Delete"
                            OnConfirm="ConfirmDelete" />
}

@code {
    [Inject] public NavigationManager Navigation { get; set; } = default!;

    [Parameter, EditorRequired] public ApiClient<T> Client { get; set; } = default!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool ShowCreateButton { get; set; } = true;
    [Parameter] public bool ShowFilterToggle { get; set; } = true;
    [Parameter] public bool ShowFiltersInitially { get; set; } = false;

    /// <summary>Varsayılan Düzenle/Sil butonları yerine özel aksiyonlar (sağ taraf). Detay butonu ayrıca en solda, bağımsız gösterilir.</summary>
    [Parameter] public RenderFragment<RowDTO>? RowActions { get; set; }

    /// <summary>Satırın en solunda Id'ye göre Details view'a giden Detay butonu gösterilsin mi.</summary>
    [Parameter] public bool ShowDetailsColumn { get; set; } = true;

    // Optional: Override default navigation paths
    [Parameter] public string? BasePath { get; set; }

    /// <summary>
    /// Academy 5.5, layer 4 (ComponentBased): action buttons follow the caller's permissions.
    ///
    /// A "Delete" button that always answers 403 is worse than no button — it teaches people the
    /// app is broken. These checks read the SAME endpoint claims the server checks, so what is
    /// visible and what is allowed cannot drift apart. It hides buttons, it does not protect data:
    /// PermissionAuthorizationFilter re-checks every call regardless of what the UI rendered.
    /// </summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ClaimsPrincipal? CurrentUser;

    private string ControllerName => BasePath ?? Client.Controller ?? typeof(T).Name;

    private bool CanCreate => CurrentUser.CanAccessEndpoint(ControllerName, "Create");
    private bool CanUpdate => CurrentUser.CanAccessEndpoint(ControllerName, "Update");
    private bool CanDelete => CurrentUser.CanAccessEndpoint(ControllerName, "Delete");

    private TableDTO? Table { get; set; }
    private bool IsLoading = true;
    private bool ShowFilters;
    private bool ShowDeleteConfirm;
    private Guid PendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        Title ??= $"{typeof(T).Name} List";
        BasePath ??= Client.Controller;
        ShowFilters = ShowFiltersInitially;

        if (AuthenticationStateTask is not null)
            CurrentUser = (await AuthenticationStateTask).User;

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            // Table null ise varsayılan istek; doluysa (sayfalama/filtre/sıralama) state'i taşır
            var request = Table ?? new TableDTO { Name = Client.Controller, ViewType = Hydra.DTOs.ViewDTOs.ViewType.ListView };

            Table = await Client.SelectAsync(request);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnTableChanged(TableDTO updatedTable)
    {
        Table = updatedTable;
        await LoadDataAsync();
    }

    private void GoToCreate() => Navigation.NavigateTo($"/{BasePath}/Create");

    private void GoToDetails(Guid id) => Navigation.NavigateTo($"/{BasePath}/Details/{id}");

    private void GoToUpdate(Guid id) => Navigation.NavigateTo($"/{BasePath}/Update/{id}");

    private void AskDelete(Guid id)
    {
        PendingDeleteId = id;
        ShowDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (PendingDeleteId == Guid.Empty)
            return;

        var success = await Client.DeleteAsync(PendingDeleteId);

        PendingDeleteId = Guid.Empty;

        if (success)
            await LoadDataAsync();
    }
}
