@inherits DropdownListComponentModel

@if (WithLabel)
{
    <div class="form-floating">
        @RenderElement()
        <LabelComponent For="@GetElementId()" Value="@LabelValue"></LabelComponent>
    </div>
}
else
{
    @RenderElement()
}

@code {

    private RenderFragment RenderElement() => __builder =>
    {
        if (!IsVisible) return;

        <select class="form-select @GetCssClass()"
                disabled="@IsDisabled"
                id="@GetElementId()"
                style="@GetCssStyle()"
                @onchange="OnSelectedValueChanged">
            @foreach (var option in Options)
            {
                <option value="@option.Key" selected="@option.IsSelected">
                    @option.Value
                </option>
            }
        </select>
        ;
    };
}
