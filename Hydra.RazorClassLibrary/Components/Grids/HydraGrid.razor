@using Hydra.DTOs
@using Hydra.DataModels
@using Hydra.RazorClassLibrary.Services.Core
@inject LookupService Lookup

@* TableDTO'dan başlık + satır + sıralama + sayfalama üreten meta-veri güdümlü grid.

   TEMA NOTU: Bu bileşen hiçbir CSS framework'üne (Bootstrap, Tailwind...) bağlı değildir.
   Sadece anlamsal (semantic) "hydra-*" class'ları basar; görünümü tamamen host projenin
   yüklediği stylesheet belirler. Nötr bir varsayılan görünüm için RCL ile birlikte gelen
   _content/Hydra.RazorClassLibrary/css/hydra-default.css dosyasını referans vermek yeterli;
   proje kendi temasını yazarak (ör. Tentacle'daki tentacle-theme.css) gridi baştan aşağı
   farklı gösterebilir. Bu yüzden buraya renk/spacing gibi görsel class'lar EKLENMEMELİ. *@

@if (Table == null)
{
    <SpinnerComponent />
}
else
{
    <div class="hydra-grid">

        @if (ShowSearchBox || ShowRecordCount)
        {
            <div class="hydra-grid__toolbar">
                @if (ShowSearchBox)
                {
                    <div class="hydra-grid__search">
                        <i class="hydra-icon bi bi-search hydra-grid__search-icon"></i>
                        <input class="hydra-input hydra-grid__search-input" type="search" placeholder="@SearchPlaceholder"
                               value="@_searchText" @oninput="e => _searchText = e.Value?.ToString() ?? string.Empty" />
                    </div>
                }

                @if (ShowRecordCount)
                {
                    <div class="hydra-grid__count">@RecordCountText</div>
                }
            </div>
        }

        <div class="hydra-grid__scroll">
            <table class="hydra-grid__table">
                <thead class="hydra-grid__head">
                    <tr class="hydra-grid__head-row">
                        @if (ShowDetailsColumn)
                        {
                            <th scope="col" class="hydra-grid__th hydra-grid__th--details"></th>
                        }
                            @foreach (var column in VisibleColumns)
                            {
                                <th scope="col"
                                    class="hydra-grid__th @(column.IsOrderable ? "hydra-grid__th--sortable" : "")"
                                    @onclick="() => OnSort(column)">
                                    <span class="hydra-grid__th-content">
                                        <span class="hydra-grid__th-label">@column.DisplayName</span>
                                        @if (column.IsOrderable)
                                        {
                                            var sortState = GetSortState(column);
                                            if (sortState != null && sortState.IsOrdered)
                                            {
                                                if (sortState.Direction == Hydra.DataModels.SortingDirection.Ascending)
                                                {
                                                    <i class="hydra-icon hydra-grid__sort-icon hydra-grid__sort-icon--active bi bi-sort-alpha-down" title="Sorted Ascending (click for Descending)"></i>
                                                }
                                                else
                                                {
                                                    <i class="hydra-icon hydra-grid__sort-icon hydra-grid__sort-icon--active bi bi-sort-alpha-up-alt" title="Sorted Descending (click to clear sorting)"></i>
                                                }
                                            }
                                            else
                                            {
                                                <i class="hydra-icon hydra-grid__sort-icon hydra-grid__sort-icon--neutral bi bi-arrow-down-up" title="Click to sort"></i>
                                            }
                                        }
                                    </span>
                                </th>
                            }
                            @if (HasActions)
                            {
                                <th class="hydra-grid__th hydra-grid__th--actions">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="hydra-grid__body">
                        @if (FilteredRows.Count == 0)
                        {
                            <tr class="hydra-grid__row hydra-grid__row--empty">
                                <td colspan="@TotalColumnCount" class="hydra-grid__cell hydra-grid__cell--empty">
                                    <div class="hydra-grid__empty-row">
                                        <i class="hydra-icon bi bi-info-circle"></i>
                                        <span>No records found.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in FilteredRows)
                            {
                                <tr class="hydra-grid__row">
                                    @if (ShowDetailsColumn)
                                    {
                                        <td class="hydra-grid__cell hydra-grid__cell--details">
                                            <button type="button" class="hydra-btn hydra-btn--icon hydra-btn--details" title="Details"
                                                    @onclick="() => DetailsClicked.InvokeAsync(row.Id)">
                                                <i class="hydra-icon bi bi-eye"></i>
                                            </button>
                                        </td>
                                    }
                                    @foreach (var column in VisibleColumns)
                                    {
                                        <td class="hydra-grid__cell">
                                            @CellText(row, column)
                                        </td>
                                    }

                                    @if (HasActions)
                                    {
                                        <td class="hydra-grid__cell hydra-grid__cell--actions">
                                            @ChildContent?.Invoke(row)
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        @if (ActiveFilterFragments.Any())
        {
            <div class="hydra-grid__active-filter-panel">
                <div class="hydra-grid__active-filter-left">
                    <i class="hydra-icon bi bi-funnel-fill hydra-grid__active-filter-icon"></i>
                    <span class="hydra-grid__active-filter-text">
                        @for (int i = 0; i < ActiveFilterFragments.Count; i++)
                        {
                            var fragment = ActiveFilterFragments[i];
                            if (i > 0)
                            {
                                <span class="hydra-grid__active-filter-and">AND</span>
                            }
                            <span class="hydra-grid__active-filter-field">[@fragment.FieldName]</span>
                            <span class="hydra-grid__active-filter-op">@fragment.Operator</span>
                            <span class="hydra-grid__active-filter-val">'@fragment.ValueText'</span>
                        }
                    </span>
                </div>
                <div class="hydra-grid__active-filter-right">
                    <button type="button" class="hydra-btn hydra-btn--icon hydra-grid__active-filter-clear"
                            title="Clear active filters"
                            @onclick="ClearActiveFilters">
                        <i class="hydra-icon bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        }

        <PaginationComponent PageNumber="@Table.PageNumber"
                             PageSize="@Table.PageSize"
                             TotalPagesCount="@Table.TotalPagesCount"
                             TotalRecordsCount="@Table.TotalRecordsCount"
                             FilteredTotalRecordsCount="@Table.FilteredTotalRecordsCount"
                             ShowPageSizeSelector="@ShowPageSizeSelector"
                             PageChanged="OnPageChanged"
                             PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@code {
    [Parameter] public TableDTO? Table { get; set; }
    [Parameter] public EventCallback<TableDTO> TableChanged { get; set; }
    [Parameter] public RenderFragment<RowDTO>? ChildContent { get; set; } // Aksiyon butonları
    [Parameter] public bool HasActions { get; set; } = true;
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;

    /// <summary>Satırın en solunda tek başına bir "Detay" butonu gösterir (Id ile Details view'a gider).
    /// DetailsClicked bağlanmadıysa hiçbir şey render edilmez (mevcut kullanımları bozmaz).</summary>
    [Parameter] public bool ShowDetailsColumnIfBound { get; set; } = true;
    [Parameter] public EventCallback<Guid> DetailsClicked { get; set; }

    /// <summary>Mevcut sayfadaki satırlar arasında hızlı, client-side arama kutusu gösterir.
    /// Varsayılan false olarak kapalıdır; kolon bazlı arama ve filtreleme FilterBarComponent
    /// üzerinden sunucu taraflı yürütülür.</summary>
    [Parameter] public bool ShowSearchBox { get; set; } = false;

    [Parameter] public string SearchPlaceholder { get; set; } = "Search this page...";

    /// <summary>Toolbar'da "1-10 / 142" biçiminde kayıt sayacı gösterir.</summary>
    [Parameter] public bool ShowRecordCount { get; set; } = true;

    private string _searchText = string.Empty;

    private bool ShowDetailsColumn => ShowDetailsColumnIfBound && DetailsClicked.HasDelegate;

    /// <summary>Hücrenin ham değerini kolonun metadata'sına göre okunabilir metne çevirir
    /// (enum 0/1/2 → isim, boolean → Evet/Hayır). Bkz. LookupService.GetDisplayText.</summary>
    private string? CellText(RowDTO row, MetaColumnDTO column)
        => Lookup.GetDisplayText(column, RawValue(row, column));

    private static object? RawValue(RowDTO row, MetaColumnDTO column)
        => row.GetValueByColumnName(column.BelongsToJoins ? column.Alias : column.Name);

    private List<MetaColumnDTO> VisibleColumns => Table == null
        ? new List<MetaColumnDTO>()
        : Table.GetSelectedMetaColumnsExceptPrimaryKeyWithIncludes
               .Where(c => !c.IsJoinedTableKey) //gizli join Id kolonları listelenmez
               .OrderBy(c => c.Priority)
               .ToList();

    private int TotalColumnCount
    {
        get
        {
            int count = VisibleColumns.Count;
            if (ShowDetailsColumn) count++;
            if (HasActions) count++;
            return Math.Max(count, 1);
        }
    }

    /// <summary>Arama kutusuna yazılan metne göre (mevcut sayfadaki) satırları süzer.
    /// Görünen tüm kolonların metin karşılığında case-insensitive "içerir" araması yapar.</summary>
    private List<RowDTO> FilteredRows
    {
        get
        {
            if (Table?.Rows == null || Table.Rows.Count == 0)
                return new List<RowDTO>();

            if (string.IsNullOrWhiteSpace(_searchText))
                return Table.Rows;

            var term = _searchText.Trim();
            var columns = VisibleColumns;

            //Ham değil, GÖRÜNEN metin üzerinden ara — böylece "Error" yazınca enum'u 0/1/2
            //olarak saklanmış satırlar da bulunur.
            return Table.Rows
                .Where(row => columns.Any(c =>
                    CellText(row, c)?.Contains(term, StringComparison.OrdinalIgnoreCase) == true))
                .ToList();
        }
    }

    /// <summary>"1-10 / 142" gibi bir sayaç metni üretir (filtre varsa filtrelenmiş toplamı baz alır).</summary>
    private string RecordCountText
    {
        get
        {
            if (Table == null)
                return string.Empty;

            var total = Table.FilteredTotalRecordsCount > 0 || Table.TotalRecordsCount == 0
                            ? Table.FilteredTotalRecordsCount
                            : Table.TotalRecordsCount;

            if (total == 0)
                return string.Empty;

            var pageSize = Table.PageSize > 0 ? Table.PageSize : total;
            var first = ((Math.Max(Table.PageNumber, 1) - 1) * pageSize) + 1;
            var last = Math.Min(first + (Table.Rows?.Count ?? 0) - 1, total);

            return $"{first}-{last} / {total}";
        }
    }

    /// <summary>Görünen kolona karşılık gelen OrderedColumn DTO'yu döner (Join/Navigation duyarlı).</summary>
    private MetaColumnDTO? GetOrderedColumnFor(MetaColumnDTO column)
    {
        if (Table == null) return null;

        return Table.GetOrderedMetaColumnsWithIncludes.FirstOrDefault(o =>
            (column.IsNavigation && o.IsNavigation &&
             o.NavigationColumnInfoDTO != null && column.NavigationColumnInfoDTO != null &&
             o.NavigationColumnInfoDTO.LeftTableName == column.NavigationColumnInfoDTO.LeftTableName &&
             o.NavigationColumnInfoDTO.RightTableName == column.NavigationColumnInfoDTO.RightTableName &&
             (o.NavigationColumnInfoDTO.NameToDisplay == column.NavigationColumnInfoDTO.NameToDisplay || o.Name == column.Name))
            ||
            (!column.IsNavigation && !o.IsNavigation &&
             o.Name == column.Name && o.TableName == column.TableName));
    }

    /// <summary>Görünen kolona karşılık gelen aktif (IsOrdered == true) OrderedColumn'u döner.</summary>
    private MetaColumnDTO? GetSortState(MetaColumnDTO column)
    {
        var match = GetOrderedColumnFor(column);
        return match != null && match.IsOrdered ? match : null;
    }

    /// <summary>
    /// GedenLines referanslı 3 durumlu sıralama döngüsü:
    /// Nötr (Sırasız) -> Ascending (Artan) -> Descending (Azalan) -> Nötr (Sıralamayı Kaldır).
    /// Tekil kolon sıralaması esastır: bir kolona tıklandığında diğer kolonların sıralaması temizlenir.
    /// </summary>
    private async Task OnSort(MetaColumnDTO column)
    {
        if (Table == null || !column.IsOrderable)
            return;

        var existingSort = GetOrderedColumnFor(column);

        // Tek kolonlu sıralama: diğer tüm kolonların sıralamasını kapat / nötrle
        foreach (var ordered in Table.GetOrderedMetaColumnsWithIncludes)
        {
            if (ordered != existingSort)
                ordered.IsOrdered = false;
        }

        if (existingSort != null)
        {
            if (!existingSort.IsOrdered)
            {
                // Durum 0 (Nötr) -> Durum 1 (ASC)
                existingSort.IsOrdered = true;
                existingSort.Direction = Hydra.DataModels.SortingDirection.Ascending;
            }
            else if (existingSort.Direction == Hydra.DataModels.SortingDirection.Ascending)
            {
                // Durum 1 (ASC) -> Durum 2 (DESC)
                existingSort.Direction = Hydra.DataModels.SortingDirection.Descending;
            }
            else
            {
                // Durum 2 (DESC) -> Durum 0 (Nötr / Reset: sıralamadan kurtulma)
                existingSort.IsOrdered = false;
            }

            Table.AlterOrAddMetaColumn(existingSort);
        }
        else
        {
            // Tabloda henüz bu kolon için OrderedColumn yok: oluştur ve ASC yap
            var orderColumn = MetaColumnDTO.CreateColumnDTOToOrder(
                name: column.Name!,
                alias: column.Alias,
                sortingDirection: Hydra.DataModels.SortingDirection.Ascending);
            orderColumn.NavigationColumnInfoDTO = column.NavigationColumnInfoDTO;
            orderColumn.TableName = column.TableName;

            Table.AlterOrAddMetaColumn(orderColumn);
        }

        await TableChanged.InvokeAsync(Table);
    }

    private async Task OnPageChanged(int page)
    {
        if (Table == null) return;

        Table.PageNumber = page;
        await TableChanged.InvokeAsync(Table);
    }

    private async Task OnPageSizeChanged(int size)
    {
        if (Table == null) return;

        Table.PageSize = size;
        Table.PageNumber = 1;
        await TableChanged.InvokeAsync(Table);
    }

    public class ActiveFilterFragment
    {
        public string FieldName { get; set; } = string.Empty;
        public string Operator { get; set; } = string.Empty;
        public string ValueText { get; set; } = string.Empty;
    }

    private List<ActiveFilterFragment> ActiveFilterFragments
    {
        get
        {
            var list = new List<ActiveFilterFragment>();
            if (Table?.MetaColumns == null) return list;

            var filteredCols = Table.GetFilteredMetaColumnsWithIncludes?
                .Where(c => c.FilterDTO != null && c.FilterDTO.Parameters != null && c.FilterDTO.Parameters.Any(p => p.Value != null && !string.IsNullOrEmpty(p.Value.ToString())))
                .ToList() ?? new List<MetaColumnDTO>();

            foreach (var col in filteredCols)
            {
                // Programmatic parent-child filters (e.g. FK = ParentId) should not be displayed
                // as interactive removable filter chips for the user.
                if (col.FilterDTO != null && !col.FilterDTO.CreateFilterComponentFromThis)
                    continue;

                var filterType = col.FilterDTO!.TypeName;
                var paramValues = col.FilterDTO.Parameters
                    .Where(p => p.Value != null && !string.IsNullOrEmpty(p.Value.ToString()))
                    .Select(p => p.Value!.ToString())
                    .ToList();

                if (!paramValues.Any()) continue;

                var fieldName = string.IsNullOrWhiteSpace(col.DisplayName) ? col.Name : col.DisplayName;
                string op = "equals";
                string valText = string.Join(" and ", paramValues);

                if (filterType == "ContainsFilter")
                {
                    op = "contains";
                    valText = paramValues[0]!;
                }
                else if (filterType == "BetweenFilter")
                {
                    op = "between";
                    valText = paramValues.Count > 1 ? $"{paramValues[0]} and {paramValues[1]}" : paramValues[0]!;
                }
                else if (col.ValueType == ColumnValueType.Boolean)
                {
                    var raw = paramValues[0]?.Trim();
                    if (raw == "1" || string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase))
                    {
                        op = "is";
                        valText = "Yes";
                    }
                    else if (raw == "0" || string.Equals(raw, "false", StringComparison.OrdinalIgnoreCase))
                    {
                        op = "is";
                        valText = "No";
                    }
                    else
                    {
                        op = "equals";
                        valText = paramValues[0];
                    }
                }

                list.Add(new ActiveFilterFragment
                {
                    FieldName = fieldName,
                    Operator = op,
                    ValueText = valText
                });
            }

            return list;
        }
    }

    private async Task ClearActiveFilters()
    {
        if (Table?.MetaColumns == null) return;

        foreach (var col in Table.MetaColumns.Where(c => c.FilterDTO != null))
        {
            col.FilterDTO!.ClearParameters();
        }

        Table.PageNumber = 1;
        await TableChanged.InvokeAsync(Table);
    }
}
