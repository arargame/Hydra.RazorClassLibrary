@using Hydra.DTOs

@* TableDTO'dan başlık + satır + sıralama + sayfalama üreten meta-veri güdümlü grid.

   TEMA NOTU: Bu bileşen hiçbir CSS framework'üne (Bootstrap, Tailwind...) bağlı değildir.
   Sadece anlamsal (semantic) "hydra-*" class'ları basar; görünümü tamamen host projenin
   yüklediği stylesheet belirler. Nötr bir varsayılan görünüm için RCL ile birlikte gelen
   _content/Hydra.RazorClassLibrary/css/hydra-default.css dosyasını referans vermek yeterli;
   proje kendi temasını yazarak (ör. Tentacle'daki tentacle-theme.css) gridi baştan aşağı
   farklı gösterebilir. Bu yüzden buraya renk/spacing gibi görsel class'lar EKLENMEMELİ. *@

@if (Table == null)
{
    <SpinnerComponent />
}
else if (Table.Rows == null || Table.Rows.Count == 0)
{
    <div class="hydra-grid__empty">
        <i class="hydra-icon bi bi-info-circle"></i>
        <span>Kayıt bulunamadı.</span>
    </div>
}
else
{
    <div class="hydra-grid">

        @if (ShowSearchBox || ShowRecordCount)
        {
            <div class="hydra-grid__toolbar">
                @if (ShowSearchBox)
                {
                    <div class="hydra-grid__search">
                        <i class="hydra-icon bi bi-search hydra-grid__search-icon"></i>
                        <input class="hydra-input hydra-grid__search-input" type="search" placeholder="@SearchPlaceholder"
                               value="@_searchText" @oninput="e => _searchText = e.Value?.ToString() ?? string.Empty" />
                    </div>
                }

                @if (ShowRecordCount)
                {
                    <div class="hydra-grid__count">@RecordCountText</div>
                }
            </div>
        }

        @if (FilteredRows.Count == 0)
        {
            <div class="hydra-grid__empty hydra-grid__empty--search">
                <i class="hydra-icon bi bi-search"></i>
                <span>Aramanızla eşleşen kayıt bulunamadı.</span>
            </div>
        }
        else
        {
            <div class="hydra-grid__scroll">
                <table class="hydra-grid__table">
                    <thead class="hydra-grid__head">
                        <tr class="hydra-grid__head-row">
                            @if (ShowDetailsColumn)
                            {
                                <th scope="col" class="hydra-grid__th hydra-grid__th--details"></th>
                            }
                            @foreach (var column in VisibleColumns)
                            {
                                <th scope="col"
                                    class="hydra-grid__th @(column.IsOrderable ? "hydra-grid__th--sortable" : "")"
                                    @onclick="() => OnSort(column)">
                                    @column.DisplayName
                                    @{ var sortState = GetSortState(column); }
                                    @if (sortState != null)
                                    {
                                        <i class="hydra-icon hydra-grid__sort-icon bi @(sortState.Direction == Hydra.DataModels.SortingDirection.Ascending ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                    }
                                </th>
                            }
                            @if (HasActions)
                            {
                                <th class="hydra-grid__th hydra-grid__th--actions">İşlemler</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="hydra-grid__body">
                        @foreach (var row in FilteredRows)
                        {
                            <tr class="hydra-grid__row">
                                @if (ShowDetailsColumn)
                                {
                                    <td class="hydra-grid__cell hydra-grid__cell--details">
                                        <button type="button" class="hydra-btn hydra-btn--icon hydra-btn--details" title="Detay"
                                                @onclick="() => DetailsClicked.InvokeAsync(row.Id)">
                                            <i class="hydra-icon bi bi-eye"></i>
                                        </button>
                                    </td>
                                }
                                @foreach (var column in VisibleColumns)
                                {
                                    <td class="hydra-grid__cell">
                                        @row.GetValueByColumnName(column.BelongsToJoins ? column.Alias : column.Name)
                                    </td>
                                }

                                @if (HasActions)
                                {
                                    <td class="hydra-grid__cell hydra-grid__cell--actions">
                                        @ChildContent?.Invoke(row)
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <PaginationComponent PageNumber="@Table.PageNumber"
                             PageSize="@Table.PageSize"
                             TotalPagesCount="@Table.TotalPagesCount"
                             TotalRecordsCount="@Table.TotalRecordsCount"
                             FilteredTotalRecordsCount="@Table.FilteredTotalRecordsCount"
                             ShowPageSizeSelector="@ShowPageSizeSelector"
                             PageChanged="OnPageChanged"
                             PageSizeChanged="OnPageSizeChanged" />
    </div>
}

@code {
    [Parameter] public TableDTO? Table { get; set; }
    [Parameter] public EventCallback<TableDTO> TableChanged { get; set; }
    [Parameter] public RenderFragment<RowDTO>? ChildContent { get; set; } // Aksiyon butonları
    [Parameter] public bool HasActions { get; set; } = true;
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;

    /// <summary>Satırın en solunda tek başına bir "Detay" butonu gösterir (Id ile Details view'a gider).
    /// DetailsClicked bağlanmadıysa hiçbir şey render edilmez (mevcut kullanımları bozmaz).</summary>
    [Parameter] public bool ShowDetailsColumnIfBound { get; set; } = true;
    [Parameter] public EventCallback<Guid> DetailsClicked { get; set; }

    /// <summary>Mevcut sayfadaki satırlar arasında hızlı, client-side arama kutusu gösterir.
    /// Bu, FilterBarComponent'in sunduğu sunucu taraflı (tüm veri seti üzerinde) kolon bazlı
    /// filtrelemenin YERİNE değil, ONA EK olarak çalışır — sadece o an ekranda görünen satırları
    /// süzer. Tüm veri setinde arama için Filtreler panelini kullanın.</summary>
    [Parameter] public bool ShowSearchBox { get; set; } = true;

    [Parameter] public string SearchPlaceholder { get; set; } = "Bu sayfada ara...";

    /// <summary>Toolbar'da "1-10 / 142" biçiminde kayıt sayacı gösterir.</summary>
    [Parameter] public bool ShowRecordCount { get; set; } = true;

    private string _searchText = string.Empty;

    private bool ShowDetailsColumn => ShowDetailsColumnIfBound && DetailsClicked.HasDelegate;

    private List<MetaColumnDTO> VisibleColumns => Table == null
        ? new List<MetaColumnDTO>()
        : Table.GetSelectedMetaColumnsExceptPrimaryKeyWithIncludes
               .Where(c => !c.IsJoinedTableKey) //gizli join Id kolonları listelenmez
               .OrderBy(c => c.Priority)
               .ToList();

    /// <summary>Arama kutusuna yazılan metne göre (mevcut sayfadaki) satırları süzer.
    /// Görünen tüm kolonların metin karşılığında case-insensitive "içerir" araması yapar.</summary>
    private List<RowDTO> FilteredRows
    {
        get
        {
            if (Table?.Rows == null)
                return new List<RowDTO>();

            if (string.IsNullOrWhiteSpace(_searchText))
                return Table.Rows;

            var term = _searchText.Trim();
            var columns = VisibleColumns;

            return Table.Rows
                .Where(row => columns.Any(c =>
                {
                    var value = row.GetValueByColumnName(c.BelongsToJoins ? c.Alias : c.Name);
                    return value?.ToString()?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
                }))
                .ToList();
        }
    }

    /// <summary>"1-10 / 142" gibi bir sayaç metni üretir (filtre varsa filtrelenmiş toplamı baz alır).</summary>
    private string RecordCountText
    {
        get
        {
            if (Table == null)
                return string.Empty;

            var total = Table.FilteredTotalRecordsCount > 0 || Table.TotalRecordsCount == 0
                            ? Table.FilteredTotalRecordsCount
                            : Table.TotalRecordsCount;

            if (total == 0)
                return string.Empty;

            var pageSize = Table.PageSize > 0 ? Table.PageSize : total;
            var first = ((Math.Max(Table.PageNumber, 1) - 1) * pageSize) + 1;
            var last = Math.Min(first + (Table.Rows?.Count ?? 0) - 1, total);

            return $"{first}-{last} / {total}";
        }
    }

    /// <summary>Görünen kolona karşılık gelen aktif OrderedColumn'u döner (arrow gösterimi için).</summary>
    private MetaColumnDTO? GetSortState(MetaColumnDTO column)
        => Table?.GetOrderedMetaColumnsWithIncludes
                 .FirstOrDefault(o => o.IsOrdered && o.Name == column.Name && o.TableName == column.TableName);

    private async Task OnSort(MetaColumnDTO column)
    {
        if (Table == null || !column.IsOrderable)
            return;

        var existingSort = Table.GetOrderedMetaColumnsWithIncludes
                                .FirstOrDefault(c => c.Name == column.Name && c.TableName == column.TableName);

        //Tek kolonlu sıralama: diğer sıralamaları kapat
        foreach (var ordered in Table.GetOrderedMetaColumnsWithIncludes)
        {
            if (ordered != existingSort)
                ordered.IsOrdered = false;
        }

        if (existingSort != null && existingSort.IsOrdered)
        {
            existingSort.Direction = existingSort.Direction == Hydra.DataModels.SortingDirection.Ascending
                ? Hydra.DataModels.SortingDirection.Descending
                : Hydra.DataModels.SortingDirection.Ascending;
        }
        else if (existingSort != null)
        {
            existingSort.IsOrdered = true;
            existingSort.Direction = Hydra.DataModels.SortingDirection.Ascending;
        }
        else
        {
            var orderColumn = MetaColumnDTO.CreateColumnDTOToOrder(name: column.Name!,
                                                                   alias: column.Alias,
                                                                   sortingDirection: Hydra.DataModels.SortingDirection.Ascending);
            orderColumn.NavigationColumnInfoDTO = column.NavigationColumnInfoDTO;

            Table.AlterOrAddMetaColumn(orderColumn);
        }

        await TableChanged.InvokeAsync(Table);
    }

    private async Task OnPageChanged(int page)
    {
        if (Table == null) return;

        Table.PageNumber = page;
        await TableChanged.InvokeAsync(Table);
    }

    private async Task OnPageSizeChanged(int size)
    {
        if (Table == null) return;

        Table.PageSize = size;
        Table.PageNumber = 1;
        await TableChanged.InvokeAsync(Table);
    }
}
