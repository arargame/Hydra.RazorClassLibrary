@inherits SpinnerComponentModel

@* Yükleniyor göstergesi.
   TEMA NOTU: CSS framework'süz, sadece anlamsal "hydra-*" class'ı basar (bkz. HydraGrid). *@

@RenderElement()

@code {

    private RenderFragment RenderElement() => __builder =>
    {
        if (!IsVisible) return;

        <div class="hydra-spinner" role="status">
            <span class="hydra-spinner__ring"></span>
            <span class="hydra-spinner__label">Yükleniyor...</span>
        </div>
        ;
    };

}
